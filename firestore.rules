rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Security helper primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && (
          request.auth.token.email == 'giangbjyx2026@gmail.com' ||
          request.auth.token.email.matches('(?i)^giangbjyx2026@gmail\\.com$')
        )) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Characters Collection
    // Public visitors can only read published characters.
    // Only verified administrators can view drafts, create, update, or delete.
    match /characters/{characterId} {
      allow get: if isValidId(characterId) && (
        (resource.data.status == 'published') || isAdmin()
      );

      allow list: if (
        resource.data.status == 'published' || isAdmin()
      );

      allow create: if isAdmin() &&
        isValidId(characterId) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 200 &&
        (request.resource.data.status == 'published' || request.resource.data.status == 'draft');

      allow update: if isAdmin() &&
        isValidId(characterId) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 200 &&
        (request.resource.data.status == 'published' || request.resource.data.status == 'draft');

      allow delete: if isAdmin() && isValidId(characterId);
    }

    // Settings Collection (Site Content & Custom Copy)
    // Public visitors can read, only verified administrators can write
    match /settings/{settingId} {
      allow get, list: if isValidId(settingId);
      allow create, update, delete: if isAdmin() && isValidId(settingId);
    }

    // Admins Collection
    match /admins/{adminId} {
      allow get: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin() && isValidId(adminId);
    }

    // Connection Health Test Path
    match /test/{testId} {
      allow get, list: if true;
    }
  }
}
