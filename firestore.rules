rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Security helper primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Strict Admin Authorization
    // Verified by existence of admin record or matched adminUid in system/admin_status
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (
          exists(/databases/$(database)/documents/system/admin_status) &&
          get(/databases/$(database)/documents/system/admin_status).data.adminUid == request.auth.uid
        ) ||
        (
          request.auth.token.email != null &&
          request.auth.token.email.matches('(?i)^giangbjyx2026@gmail\\.com$')
        )
      );
    }

    // Characters Collection
    // Public visitors can only read published characters.
    // Only verified administrators can view drafts, create, update, or delete.
    match /characters/{characterId} {
      allow get: if isValidId(characterId) && (
        (resource.data.status == 'published') || isAdmin()
      );

      allow list: if (
        resource.data.status == 'published' || isAdmin()
      );

      allow create: if isAdmin() &&
        isValidId(characterId) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 200 &&
        (request.resource.data.status == 'published' || request.resource.data.status == 'draft');

      allow update: if isAdmin() &&
        isValidId(characterId) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 200 &&
        (request.resource.data.status == 'published' || request.resource.data.status == 'draft');

      allow delete: if isAdmin() && isValidId(characterId);
    }

    // Settings Collection (Site Content, Custom Copy & Music Settings)
    // Public visitors can read, only verified administrators can write
    match /settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if true;
      allow create, update, delete: if isAdmin() && isValidId(settingId);
    }

    // Music Tracks Collection
    // Public visitors can only list/get public tracks.
    // Verified administrators can view all (public & hidden), create, update, or delete.
    match /music_tracks/{trackId} {
      allow get: if isValidId(trackId) && (
        (resource.data.isPublic == true) ||
        (resource.data.status == 'published') ||
        isAdmin()
      );

      allow list: if (
        (resource.data.isPublic == true) ||
        (resource.data.status == 'published') ||
        isAdmin()
      );

      allow create: if isAdmin() &&
        isValidId(trackId) &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.title.size() <= 300 &&
        request.resource.data.url is string &&
        request.resource.data.url.size() > 0 &&
        request.resource.data.url.size() <= 2000;

      allow update: if isAdmin() &&
        isValidId(trackId) &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.title.size() <= 300 &&
        request.resource.data.url is string &&
        request.resource.data.url.size() > 0 &&
        request.resource.data.url.size() <= 2000;

      allow delete: if isAdmin() && isValidId(trackId);
    }

    // System Status Collection (Admin First-Time Initialization Lock)
    // Public visitors can read to check if admin setup has already been initialized.
    // Can only be created once when admin_status does not exist yet.
    // Permanent lock: update and delete are strictly forbidden.
    match /system/{systemId} {
      allow get: if isValidId(systemId);
      allow list: if false;
      allow create: if isSignedIn() &&
        systemId == 'admin_status' &&
        !exists(/databases/$(database)/documents/system/admin_status) &&
        request.resource.data.isInitialized == true &&
        request.resource.data.adminUid == request.auth.uid &&
        request.resource.data.adminEmail is string &&
        request.resource.data.adminEmail.size() > 3;
      allow update, delete: if false;
    }

    // Admins Collection
    // Admin record can be created during first-time setup or by an authenticated admin.
    // Once created, deletion is prevented to protect curator authority.
    match /admins/{adminId} {
      allow get: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() &&
        isValidId(adminId) &&
        request.auth.uid == adminId &&
        (
          !exists(/databases/$(database)/documents/system/admin_status) ||
          isAdmin()
        ) &&
        request.resource.data.role == 'admin';
      allow update: if isAdmin() && isValidId(adminId);
      allow delete: if false;
    }

    // Connection Health Test Path
    match /test/{testId} {
      allow get, list: if true;
    }
  }
}
